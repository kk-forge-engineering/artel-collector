# npm resolves only versions out for a week, long enough for a hijacked release to be spotted.
min-release-age=7
# Our own packages skip the wait: our CI publishes them through trusted publishing, with provenance.
min-release-age-exclude[]=@kk-forge/*
# npm runs a dependency's install script only when package.json's allowScripts approves that package.
strict-allow-scripts=true
# allowScripts:
# fsevents: denied. Vite's file watcher on macOS takes it, and its package ships the prebuilt fsevents.node.
