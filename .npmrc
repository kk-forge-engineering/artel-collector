# npm runs a dependency's install script only when package.json's allowScripts approves that package.
# An install script runs the package's code on the machine that installs it.
strict-allow-scripts=true
# Why each package.json allowScripts entry approves or denies its package:
# fsevents: denied. Vite uses it for file watching on macOS, and the package ships a prebuilt fsevents.node.
