{
  "name": "@kk-forge/artel-collector",
  "version": "0.6.1",
  "description": "Sends a product's analytics events to the intake service",
  "license": "MIT",
  "author": "KK Forge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kk-forge-engineering/artel-collector.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/shared/exports.js",
  "types": "./dist/shared/exports.d.ts",
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "exports": {
    ".": {
      "types": "./dist/shared/exports.d.ts",
      "default": "./dist/shared/exports.js"
    },
    "./infra": {
      "types": "./dist/infra/exports.d.ts",
      "default": "./dist/infra/exports.js"
    },
    "./infra/chrome": {
      "types": "./dist/infra/chrome/exports.d.ts",
      "default": "./dist/infra/chrome/exports.js"
    },
    "./testing": {
      "types": "./dist/testing/exports.d.ts",
      "default": "./dist/testing/exports.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "node --eval \"process.getBuiltinModule('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "lint": "npm run lint:tsc && npm run lint:oxlint && npm run lint:format",
    "lint:fix": "npm run lint:oxlint:fix && npm run lint:format:fix",
    "lint:tsc": "tsc && tsc -p tsconfig.dom.json && tsc -p tsconfig.node.json",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:format": "oxfmt --check .",
    "lint:format:fix": "oxfmt .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:ci": "vitest run --coverage"
  },
  "devDependencies": {
    "@kk-forge/oxlint-config": "^15.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "allowScripts": {
    "fsevents": false
  }
}
